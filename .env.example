# =========================================================
# 多Agent量化交易系统 V1 - 环境变量模板
# 复制为 .env 并填写真实值
# =========================================================

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantiagent
DB_USER=quantiagent
DB_PASSWORD=quantiagent

# ---- LLM (OpenAI 兼容接口) ----
# 不配置时系统自动进入"规则模拟"降级模式，跑通全链路后再填真实值
LLM_BASE_URL=
LLM_API_KEY=
LLM_FAST_MODEL=
LLM_DEEP_MODEL=
LLM_EMBEDDING_MODEL=

# ---- 邮件 (SMTP) ----
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SENDER=
EMAIL_SENDER_PASS=
EMAIL_RECEIVER=
EMAIL_EXTRA_RECEIVERS=

# ---- Tushare Pro (可选, 有 token 才启用) ----
TUSHARE_TOKEN=
